{
  "name": "githubpro",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prepare": "./scripts/prepare-effect.sh && bun run types",
    "types": "wxt prepare",
    "dev": "wxt",
    "build": "bun scripts/build-diff-engine.ts && wxt build",
    "build:diff-engine": "bun scripts/build-diff-engine.ts",
    "reload": "bun run build && ego-browser nodejs < scripts/ego-extension.js",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "drift": "bun scripts/check-drift.ts",
    "verify:live": "wxt build && bun scripts/verify-on-github.ts",
    "test": "bun test",
    "test:watch": "bun test --watch"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.11.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.2.2",
    "happy-dom": "^20.11.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "wxt": "^0.20.27"
  },
  "dependencies": {
    "@pierre/diffs": "^1.2.12",
    "@pierre/trees": "^1.0.0-beta.6",
    "@primer/octicons-react": "^19.31.0",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@sentry/browser": "^10.68.0",
    "effect": "^4.0.0-beta.101",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
