{
  "name": "gitquiet",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "workspaces": ["desktop"],
  "scripts": {
    "prepare": "./scripts/prepare.sh",
    "types": "wxt prepare",
    "dev": "bun scripts/dev.ts",
    "dev:wxt": "wxt",
    "dev:ego": "ego-browser nodejs < scripts/ego-dev.js",
    "build": "bun scripts/build-tree-icons.ts && bun scripts/build-diff-engine.ts && bun scripts/build-markdown-mermaid.ts && bun scripts/build-gates.ts && bun scripts/build-canary-manifest.ts && bun scripts/build-screens.ts && wxt build",
    "build:gates": "bun scripts/build-gates.ts",
    "build:screens": "bun scripts/build-screens.ts",
    "build:diff-engine": "bun scripts/build-diff-engine.ts",
    "build:markdown-mermaid": "bun scripts/build-markdown-mermaid.ts",
    "reload": "bun run build && ego-browser nodejs < scripts/ego-extension.js",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "build:safari": "wxt build -b safari --mv3",
    "compile": "tsc --noEmit",
    "compile:desktop": "tsc --noEmit -p desktop/tsconfig.json",
    "lint": "oxlint src",
    "gates": "bun run lint && bun run compile && bun run compile:desktop && bun run test -- --parallel --dots",
    "qa": "bun scripts/qa-shots.ts",
    "shots:dev": "vite --config shots/vite.config.ts",
    "shots": "sed \"s|__REPO__|$PWD|\" shots/capture.js | ego-browser nodejs",
    "assets": "sed \"s|__REPO__|$PWD|\" shots/store-assets.js | ego-browser nodejs",
    "copy": "ego-browser nodejs < site/copy.js",
    "bench": "bun scripts/benchmark-pull-request.ts",
    "drift": "bun scripts/check-drift.ts",
    "canary": "bun scripts/build-canary-manifest.ts && sed \"s|__REPO__|$PWD|\" scripts/canary.js | ego-browser nodejs",
    "build:canary-manifest": "bun scripts/build-canary-manifest.ts",
    "verify:live": "wxt build && bun scripts/verify-on-github.ts",
    "test": "bun test --timeout 40000",
    "test:watch": "bun test --timeout 40000 --watch",
    "build:tree-icons": "bun scripts/build-tree-icons.ts"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.12.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/bun": "^1.4.0",
    "@types/markdown-it": "^14.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@wxt-dev/module-react": "^1.2.2",
    "happy-dom": "^20.12.0",
    "lefthook": "^2.1.12",
    "material-icon-theme": "^5.38.1",
    "oxlint": "^1.80.0",
    "oxlint-plugin-eslint": "^1.80.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "wxt": "^0.21.4"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.0",
    "@hugeicons/react": "^1.1.10",
    "@pierre/diffs": "^1.3.6",
    "@pierre/trees": "^1.0.0-beta.6",
    "@primer/octicons-react": "^19.33.0",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@sentry/browser": "^10.72.0",
    "effect": "^4.0.0-rc.111",
    "gemoji": "^8.1.0",
    "markdown-it": "^15.0.1",
    "marked": "^18.0.11",
    "mermaid": "^11.17.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.7"
  }
}
