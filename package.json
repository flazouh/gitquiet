{
  "name": "gitquiet",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "workspaces": ["desktop"],
  "scripts": {
    "prepare": "./scripts/prepare-effect.sh && bun run types",
    "types": "wxt prepare",
    "dev": "bun scripts/dev.ts",
    "dev:wxt": "wxt",
    "dev:ego": "ego-browser nodejs < scripts/ego-dev.js",
    "build": "bun scripts/build-tree-icons.ts && bun scripts/build-diff-engine.ts && bun scripts/build-gates.ts && bun scripts/build-screens.ts && wxt build",
    "build:gates": "bun scripts/build-gates.ts",
    "build:screens": "bun scripts/build-screens.ts",
    "build:diff-engine": "bun scripts/build-diff-engine.ts",
    "reload": "bun run build && ego-browser nodejs < scripts/ego-extension.js",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "lint": "oxlint src",
    "shots:dev": "vite --config shots/vite.config.ts",
    "shots": "ego-browser nodejs < shots/capture.js",
    "assets": "ego-browser nodejs < shots/store-assets.js",
    "copy": "ego-browser nodejs < site/copy.js",
    "bench": "bun scripts/benchmark-pull-request.ts",
    "drift": "bun scripts/check-drift.ts",
    "verify:live": "wxt build && bun scripts/verify-on-github.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "build:tree-icons": "bun scripts/build-tree-icons.ts"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.11.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "^1.3.14",
    "@types/markdown-it": "^14.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.2.2",
    "happy-dom": "^20.11.1",
    "material-icon-theme": "^5.37.0",
    "oxlint": "^1.76.0",
    "oxlint-plugin-eslint": "^1.76.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "wxt": "^0.20.27"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.2.3",
    "@hugeicons/react": "^1.1.9",
    "@pierre/diffs": "^1.2.12",
    "@pierre/trees": "^1.0.0-beta.6",
    "@primer/octicons-react": "^19.31.0",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@sentry/browser": "^10.68.0",
    "effect": "^4.0.0-beta.101",
    "markdown-it": "^14.3.0",
    "marked": "^18.0.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.7"
  }
}
