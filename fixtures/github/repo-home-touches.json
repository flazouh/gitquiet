      "shortMessageHtmlLink": {
        "value": "<a data-pjax=\"true\" title=\"The reads behind repositories, activity and issues\n\nThree new reads, each as a domain module with the shape and a github module with\nthe request: the repositories a reader has, the activity on them, and the issues\nthey are involved in. The gateway and its port grow the three methods, and the\nworking set and the intent that routes to it are widened to carry issues beside\npull requests.\n\nCo-authored-by: Cursor &lt;cursoragent@cursor.com&gt;\" class=\"Link--secondary\" href=\"/flazouh/githubpro/commit/085c9d68839fa057cf1d80af78a44d4b630145ff\">The reads behind repositories, activity and issues</a>"
      }
    },
